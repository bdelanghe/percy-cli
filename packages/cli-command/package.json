{
  "name": "@percy/cli-command",
  "version": "1.31.5-beta.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/percy/cli",
    "directory": "packages/cli-command"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "dist",
    "test/helpers.js"
  ],
  "engines": {
    "node": ">=14"
  },
  "bin": {
    "percy-cli-readme": "./bin/readme.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./test/helpers": "./test/helpers.js"
  },
  "scripts": {
    "build": "node ../../scripts/build",
    "lint": "eslint --ignore-path ../../.gitignore .",
    "test": "node ../../scripts/test",
    "test:coverage": "node ../../scripts/test --coverage"
  },
  "dependencies": {
    "@percy/config": "1.31.5-beta.1",
    "@percy/core": "1.31.5-beta.1",
    "@percy/logger": "1.31.5-beta.1"
  }
}
