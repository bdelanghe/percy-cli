{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/percy/cli"
  },
  "scripts": {
    "build_cjs": "bun run --filter './packages/*' build --node",
    "build": "bun run --filter './packages/*' build",
    "build:watch": "bun run --filter './packages/*' build --watch",
    "build:pack": "mkdir -p ./packs && for pkg in packages/*; do (cd \"$pkg\" && bun pack) && mv \"$pkg\"/*.tgz ./packs/ 2>/dev/null || true; done",
    "bump-version": "echo 'Version bumping - implement with Bun workspace versioning'",
    "chromium-revision": "./scripts/chromium-revision.js",
    "clean": "git clean -Xdf -e !node_modules -e !**/node_modules/**",
    "lint": "eslint --ignore-path .gitignore .",
    "readme": "bun run --filter './packages/*' readme",
    "postinstall": "bun run --filter './packages/*' postinstall",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:types": "bun run --filter './packages/*' test:types",
    "global:link": "bun link",
    "global:unlink": "bun unlink"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.14.7",
    "cross-env": "^7.0.2",
    "eslint": "^7.30.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "gaze": "^1.1.3",
    "jasmine": "^4.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.0.2",
    "karma-chrome-launcher": "^3.1.0",
    "karma-firefox-launcher": "^2.1.1",
    "karma-jasmine": "^5.0.0",
    "karma-mocha-reporter": "^2.2.5",
    "@nx/nx-darwin-arm64": "17.3.0",
    "memfs": "^3.4.0",
    "nyc": "^15.1.0",
    "tsd": "^0.31.2"
  }
}
