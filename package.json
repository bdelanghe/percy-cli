{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/percy/cli"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "build:watch": "bun run --filter './packages/*' build --watch",
    "build_cjs": "bun run --filter '@percy/cli...' build --node",
    "lint": "bun run --filter './packages/*' lint",
    "readme": "bun run --filter './packages/*' readme",
    "test": "bun run --filter './packages/*' test",
    "test:coverage": "bun run --filter './packages/*' test:coverage",
    "test:types": "bun run --filter './packages/*' test:types",
    "postinstall": "bun run --filter './packages/*' postinstall"
  },
  "devDependencies": {
    "eslint": "^7.30.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "jsdom": "^24.0.0",
    "memfs": "^3.4.0",
    "tsd": "^0.31.2",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
